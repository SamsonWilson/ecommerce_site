# Copier en .env puis adapter :  cp .env.example .env
# ---------------------------------------------------------------------------

# Django : dev (permissif, http local) ou prod (durci, https)
DJANGO_SETTINGS_MODULE=backend.settings.dev
SECRET_KEY=change-moi-avec-une-vraie-cle-secrete
DEBUG=False
ALLOWED_HOSTS=ecommerce.ginolux.com,localhost,127.0.0.1,web,backend

# Base de données PostgreSQL
POSTGRES_DB=maisonlian
POSTGRES_USER=maisonlian
POSTGRES_PASSWORD=change-moi

# CORS ET CSRF : origines autorisées du frontend et du domaine
CORS_ALLOWED_ORIGINS=https://ecommerce.ginolux.com,http://ecommerce.ginolux.com,http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=https://ecommerce.ginolux.com,http://ecommerce.ginolux.com,http://localhost:5173,http://localhost

# --- Connexion par réseaux sociaux ---------------------------------------
# URL publique du frontend (sert à construire l'URI de redirection OAuth)
FRONTEND_URL=https://ecommerce.ginolux.com

# Google — console.cloud.google.com > Identifiants > OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook / Instagram — developers.facebook.com > Mon app > Facebook Login
# URI de redirection à déclarer : <FRONTEND_URL>/compte/connexion/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Envoi des e-mails (inscription, mot de passe oublié, devis) ----------
# Sans EMAIL_HOST, les messages s'affichent dans la console et NE PARTENT PAS.
#
# Option A — Gmail (rapide, pour tester) :
#   1. Activer la validation en 2 étapes sur le compte Google
#   2. Créer un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#   3. Coller ces 16 caractères (sans espaces) dans EMAIL_HOST_PASSWORD
#   ⚠ Votre mot de passe Gmail habituel ne fonctionnera PAS.
#   ⚠ Limite ~500 envois/jour — insuffisant pour la production.
#
# Option B — Brevo / SendGrid (recommandé en production, cf. ARCHITECTURE §10) :
#   EMAIL_HOST=smtp-relay.brevo.com  /  EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Traduction du catalogue (fr -> zh, en) ------------------------------
# Facultatif. Sans clé, le service gratuit MyMemory traduit ce qui est enregistré.
# Avec une clé (https://console.anthropic.com), Claude offre une meilleure qualité.
ANTHROPIC_API_KEY=

# --- Virement bancaire (T/T) pour les grossistes et les devis -----------
# Facultatif. Sans titulaire, numéro de compte et BIC, le virement n'est pas proposé.
# Ces valeurs restent sur le serveur : un compte employé piraté ne peut pas
# les remplacer pour détourner les paiements.
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_BANK=
BANK_TRANSFER_ACCOUNT=
BANK_TRANSFER_BIC=
BANK_TRANSFER_BANK_ADDRESS=
# Jours de réservation des articles en attendant le virement.
# Lancer chaque jour : python manage.py expire_transfers
BANK_TRANSFER_DAYS=7

# --- Paiement en ligne (Airwallex) ---------------------------------------
# Facultatif. Sans ces trois valeurs, seul le paiement à la livraison est proposé.
# Tableau de bord Airwallex > Developer > API keys : Client ID et clé API.
# Webhooks : ajouter l'URL <FRONTEND_URL>/api/v1/webhooks/airwallex/ avec les
# événements payment_intent.succeeded, payment_intent.cancelled,
# refund.accepted, refund.settled et refund.failed, puis copier son secret.
# Commencer par les clés de test (sandbox), jamais celles de production.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
# sandbox (essais) ou prod (encaissement réel)
AIRWALLEX_ENV=sandbox
# Facultatif : déduit de AIRWALLEX_ENV. À vérifier dans le tableau de bord en production.
# AIRWALLEX_API_BASE=https://api.airwallex.com

# --- Stockage des photos produits ----------------------------------------
# Par défaut (USE_S3=False) les photos sont écrites dans backend/media/.
# Cela ne tient QUE si un seul backend tourne : avec plusieurs réplicas,
# chacun n'aurait que les fichiers qu'il a lui-même reçus.
#
# Cloudflare R2 :
#   AWS_S3_ENDPOINT_URL=https://<compte>.r2.cloudflarestorage.com
#   AWS_S3_CUSTOM_DOMAIN=media.mondomaine.com   (domaine public du bucket)
# Amazon S3 :
#   laisser AWS_S3_ENDPOINT_URL vide et renseigner AWS_S3_REGION_NAME
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_LOCATION=media

# Sécurité — à passer à True en production derrière HTTPS
REFRESH_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
