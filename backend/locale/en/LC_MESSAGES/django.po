msgstr "The payment provider refused the refund. Nothing has been refunded."

msgid "Le prestataire de ce paiement n'est plus configuré."
msgstr "The provider for this payment is no longer configured."

#, python-format
msgid "Montant remboursable : %(amount)s %(currency)s."
msgstr "Refundable amount: %(amount)s %(currency)s."

#, python-format
msgid "Merci pour votre commande %(reference)s."
msgstr "Thank you for your order %(reference)s."

#, python-format
msgid "Sous-total : %(amount)s"
msgstr "Subtotal: %(amount)s"

#, python-format
msgid "Livraison : %(amount)s"
msgstr "Delivery: %(amount)s"

#, python-format
msgid "Total : %(amount)s"
msgstr "Total: %(amount)s"

msgid "Votre paiement a bien été reçu."
msgstr "Your payment has been received."

#, python-format
msgid "Vous réglerez %(amount)s à la livraison ou au retrait."
msgstr "You will pay %(amount)s on delivery or at pickup."

msgid "Conservez cette référence pour tout échange avec nous."
msgstr "Keep this reference for any contact with us."

#, python-format
msgid "Votre commande %(reference)s"
msgstr "Your order %(reference)s"

msgid "Les frais de port ne peuvent changer que pour un paiement à la livraison."
msgstr "Delivery costs can only be changed for payment on delivery."

msgid "Une commande liée à un paiement en ligne ne peut pas être supprimée."
msgstr "An order linked to an online payment cannot be deleted."

msgid "Seuls un administrateur ou un responsable peuvent enregistrer un virement."
msgstr "Only an administrator or a manager can record a bank transfer."

msgid "Référence invalide."
msgstr "Invalid reference."

msgid "Ce virement est déjà enregistré."
msgstr "This transfer has already been recorded."

msgid "Cette commande n'attend pas de virement."
msgstr "This order is not awaiting a bank transfer."

#, python-format
msgid "Merci de virer %(amount)s avant le %(date)s, en indiquant la référence %(reference)s :"
msgstr "Please transfer %(amount)s before %(date)s, quoting the reference %(reference)s:"

