msgid "Titulaire : %(value)s"
msgstr "Account holder: %(value)s"

#, python-format
msgid "Banque : %(value)s"
msgstr "Bank: %(value)s"

#, python-format
msgid "IBAN / n° de compte : %(value)s"
msgstr "IBAN / account number: %(value)s"

#, python-format
msgid "BIC / SWIFT : %(value)s"
