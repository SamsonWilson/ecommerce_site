msgid "Requête invalide."
msgstr "请求无效。"

msgid "Seule la caisse peut enregistrer une vente payée."
msgstr "只有收银台可以登记已付款的销售。"

msgid "Adresse email obligatoire."
msgstr "请填写电子邮箱。"

msgid "Adresse email invalide."
msgstr "电子邮箱格式不正确。"

msgid "Le panier est vide."
msgstr "购物车是空的。"

msgid "Liste d'articles invalide."
msgstr "商品列表无效。"

msgid "Adresse de livraison invalide."
msgstr "收货地址无效。"

msgid "Moyen de paiement invalide."
msgstr "付款方式无效。"

msgid "Article invalide."
msgstr "商品无效。"

