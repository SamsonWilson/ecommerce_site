msgid "Pays de livraison invalide."
msgstr "收货国家无效。"

msgid "Ce mode de livraison n'est pas disponible pour cette adresse."
msgstr "该配送方式不适用于此地址。"

msgid "Le paiement à la livraison n'est pas proposé avec ce mode de livraison."
msgstr "此配送方式不支持货到付款。"

msgid "Commande introuvable."
msgstr "找不到该订单。"

msgid "Cette commande n'est plus en attente de paiement."
msgstr "此订单已不再等待付款。"

msgid "Le paiement en ligne n'est pas disponible pour le moment."
msgstr "暂时无法在线付款。"

msgid "Le service de paiement ne répond pas. Veuillez réessayer dans quelques instants."
msgstr "支付服务无响应，请稍后再试。"

msgid "Seuls un administrateur ou un responsable peuvent rembourser."
msgstr "只有管理员或店长可以退款。"

msgid "Aucun paiement en ligne à rembourser."
msgstr "没有可退款的在线付款。"

msgid "Montant invalide."
msgstr "金额无效。"

msgid "Motif invalide."
msgstr "原因无效。"

msgid "Le prestataire a refusé le remboursement. Rien n'a été remboursé."
msgstr "支付服务商拒绝了退款，未退还任何款项。"

msgid "Le prestataire de ce paiement n'est plus configuré."
msgstr "该付款的服务商已不再配置。"

#, python-format
msgid "Montant remboursable : %(amount)s %(currency)s."
msgstr "可退款金额：%(amount)s %(currency)s。"

#, python-format
msgid "Merci pour votre commande %(reference)s."
msgstr "感谢您的订单 %(reference)s。"

#, python-format
msgid "Sous-total : %(amount)s"
msgstr "小计：%(amount)s"

#, python-format
msgid "Livraison : %(amount)s"
msgstr "运费：%(amount)s"

#, python-format
msgid "Total : %(amount)s"
msgstr "总计：%(amount)s"

msgid "Votre paiement a bien été reçu."
msgstr "我们已收到您的付款。"

#, python-format
msgid "Vous réglerez %(amount)s à la livraison ou au retrait."
msgstr "您将在收货或取货时支付 %(amount)s。"

msgid "Conservez cette référence pour tout échange avec nous."
msgstr "请保留此订单号，以便与我们联系。"

#, python-format
msgid "Votre commande %(reference)s"
msgstr "您的订单 %(reference)s"

msgid "Les frais de port ne peuvent changer que pour un paiement à la livraison."
msgstr "只有货到付款的订单才能修改运费。"

msgid "Une commande liée à un paiement en ligne ne peut pas être supprimée."
msgstr "已关联在线付款的订单不能删除。"

msgid "Seuls un administrateur ou un responsable peuvent enregistrer un virement."
msgstr "只有管理员或店长可以登记银行转账。"

msgid "Référence invalide."
msgstr "参考号无效。"

msgid "Ce virement est déjà enregistré."
msgstr "此转账已登记。"

msgid "Cette commande n'attend pas de virement."
msgstr "此订单不在等待银行转账。"

#, python-format
msgid "Merci de virer %(amount)s avant le %(date)s, en indiquant la référence %(reference)s :"
msgstr "请在 %(date)s 之前转账 %(amount)s，并注明参考号 %(reference)s："

#, python-format
msgid "Titulaire : %(value)s"
msgstr "收款人：%(value)s"

#, python-format
msgid "Banque : %(value)s"
msgstr "银行：%(value)s"

#, python-format
msgid "IBAN / n° de compte : %(value)s"
msgstr "IBAN / 账号：%(value)s"

#, python-format
msgid "BIC / SWIFT : %(value)s"
msgstr "BIC / SWIFT：%(value)s"

#, python-format
msgid "Adresse de la banque : %(value)s"
msgstr "银行地址：%(value)s"

msgid "Les articles vous sont réservés jusqu'à cette date."
msgstr "商品将为您保留至该日期。"

msgid "Ce devis ne peut plus être modifié."
msgstr "此报价已无法修改。"

msgid "Ce devis ne contient aucun article à chiffrer."
msgstr "此报价没有需要定价的商品。"

msgid "Indiquez un prix pour chaque article."
msgstr "请为每件商品填写价格。"

msgid "Ce devis n'est pas ou plus disponible."
msgstr "此报价不可用或已失效。"

msgid "Ce devis a expiré. Demandez-nous une mise à jour."
msgstr "此报价已过期，请联系我们更新。"

msgid "Devis introuvable."
msgstr "找不到该报价。"

msgid "Adresse de livraison incomplète."
msgstr "收货地址不完整。"

msgid "Date invalide."
msgstr "日期无效。"

#, python-format
msgid "Voici notre devis %(reference)s :"
msgstr "这是我们的报价 %(reference)s："

#, python-format
msgid "Valable jusqu'au %(date)s."
msgstr "有效期至 %(date)s。"

msgid "Pour l'accepter et le régler :"
msgstr "接受并付款："

#, python-format
msgid "Votre devis %(reference)s"
msgstr "您的报价 %(reference)s"
