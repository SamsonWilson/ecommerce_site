# Copier en .env puis adapter :  cp .env.example .env
# ---------------------------------------------------------------------------

# Django : dev (permissif, http local) ou prod (durci, https)
DJANGO_SETTINGS_MODULE=backend.settings.dev
SECRET_KEY=change-moi-avec-une-vraie-cle-secrete
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,backend

# Base de données PostgreSQL
POSTGRES_DB=maisonlian
POSTGRES_USER=maisonlian
POSTGRES_PASSWORD=change-moi

# CORS : origines autorisées du frontend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# --- Connexion par réseaux sociaux ---------------------------------------
# URL publique du frontend (sert à construire l'URI de redirection OAuth)
FRONTEND_URL=http://localhost:5173

# Google — console.cloud.google.com > API et services > Identifiants
#   1. Créer un « ID client OAuth 2.0 » de type « Application Web »
#   2. Origines JavaScript autorisées :  http://localhost:5173
#                                        http://localhost
#   3. Coller l'ID ci-dessous (il finit par .apps.googleusercontent.com)
# Cette seule variable alimente le backend ET le bouton du frontend.
GOOGLE_CLIENT_ID=1083794115414-3dg19bh5mans9lvcd873pb69nn065d1p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=1083794115414-3dg19bh5mans9lvcd873pb69nn065d1p.apps.googleusercontent.com
# Facebook / Instagram — developers.facebook.com > Mon app > Facebook Login
# URI de redirection à déclarer : <FRONTEND_URL>/compte/connexion/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Envoi des e-mails (inscription, mot de passe oublié, devis) ----------
# Sans EMAIL_HOST, les messages s'affichent dans la console et NE PARTENT PAS.
#
# Option A — Gmail (rapide, pour tester) :
#   1. Activer la validation en 2 étapes sur le compte Google
#   2. Créer un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#   3. Coller ces 16 caractères (sans espaces) dans EMAIL_HOST_PASSWORD
#   ⚠ Votre mot de passe Gmail habituel ne fonctionnera PAS.
#   ⚠ Limite ~500 envois/jour — insuffisant pour la production.
#
# Option B — Brevo / SendGrid (recommandé en production, cf. ARCHITECTURE §10) :
#   EMAIL_HOST=smtp-relay.brevo.com  /  EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=wilsonhugues364@gmail.com
EMAIL_HOST_PASSWORD=hhkxsoprqpxpdxcp
DEFAULT_FROM_EMAIL=

# Sécurité — à passer à True en production derrière HTTPS
REFRESH_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
